datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String       @id @default(uuid())
  name            String
  email           String       @unique
  passwordHash    String?
  role            String       @default("usuario")
  slug            String       @unique
  avatarUrl       String?
  autoSettle      Boolean      @default(true)
  deteccaoCasa    Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  bancas          Banca[]
  telegramAccount UserTelegram?
  assinatura      Assinatura?
}

model UserTelegram {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramId      String?      @unique
  name            String?
  username        String?
  codigoVinculo   String?
  codigoValidoAte DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Plan {
  id              String       @id @default(uuid())
  name            String       // "Plano Gratuito", "Plus"
  price           Float        @default(0.00)
  periodicity     String       @default("year")
  limiteApostas   Int          @default(10)
  limiteTips      Int          @default(10)
  assinaturas     Assinatura[]
}

model Assinatura {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            Plan         @relation(fields: [planId], references: [id])
  status          String       @default("active")
  startedAt       DateTime     @default(now())
  expiresAt       DateTime?
}

model Banca {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome            String       // Ex: "Oficial"
  descricao       String?      // Descrição opcional da banca.
  cor             String       @default("#3b82f6")
  valorInicial    Float        @default(3000.00)
  saldoBanco      Float        @default(3000.00)
  unidadeEfetiva  Float        @default(100.00)
  ativa           Boolean      @default(true)
  padrao          Boolean      @default(true)
  compartilhada   Boolean      @default(false)
  slug            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  contas          ContaBookmaker[]
  transacoes      Transacao[]
  apostas         Aposta[]
}

model ContaBookmaker {
  id              String       @id @default(uuid())
  bancaId         String
  banca           Banca        @relation(fields: [bancaId], references: [id], onDelete: Cascade)
  nomeCasa        String       // Ex: "Bet365", "Betano", "Betfair", "Estrelabet", "Superbet"
  saldoAtual      Float        @default(0.00)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  transacoes      Transacao[]
  apostas         Aposta[]
}

model Transacao {
  id              String         @id @default(uuid())
  bancaId         String
  banca           Banca          @relation(fields: [bancaId], references: [id], onDelete: Cascade)
  contaId         String?
  conta           ContaBookmaker? @relation(fields: [contaId], references: [id])
  tipo            String         // "APORTE", "RETIRADA", "DEPOSITO_CASA", "SAQUE_CASA", "AJUSTE"
  valor           Float
  data            DateTime       @default(now())
  descricao       String?
}

model Aposta {
  id              String         @id @default(uuid())
  bancaId         String
  banca           Banca          @relation(fields: [bancaId], references: [id], onDelete: Cascade)
  contaId         String?
  conta           ContaBookmaker? @relation(fields: [contaId], references: [id])
  esporte         String         @default("Futebol")
  evento          String         // Ex: "Cruzeiro x Athletico-PR"
  mercado         String         // Ex: "Mais de 2.5 gols"
  odd             Float          @default(1.50)
  stake           Float          @default(10.00)
  status          String         @default("PENDENTE") // "PENDENTE", "GREEN", "RED", "REEMBOLSO", "MEIO_GREEN", "MEIO_RED"
  lucroPrejuizo   Float?
  tipster         String?        // Ex: "Oficial", "Sem tipster"
  dataJogo        DateTime       @default(now())
  observacoes     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Tip {
  id              String         @id @default(uuid())
  titulo          String
  descricao       String?
  esporte         String
  evento          String
  mercado         String
  oddRecomendada  Float          @default(1.80)
  stakeSugerida   Float          @default(1.0)
  resultado       String         @default("PENDENTE") // "PENDENTE", "GREEN", "RED", "REEMBOLSO"
  dataEvento      DateTime       @default(now())
  createdAt       DateTime       @default(now())

  resultClassifications ResultClassification[]
}

// A source is inactive until its authorization is recorded and enabled.
model DataSource {
  id               String          @id @default(uuid())
  platform         String          @default("telegram")
  externalChatId   String
  chatType         String
  titleSnapshot    String?
  usernameSnapshot String?
  authorizationRef String
  authorizedAt     DateTime
  activatedAt      DateTime?
  active           Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  messages         SourceMessage[]
  collectionRuns   CollectionRun[]

  @@unique([platform, externalChatId])
}

// Each edit or observed deletion is a new revision. Never overwrite an earlier row.
model SourceMessage {
  id                     String                 @id @default(uuid())
  dataSourceId           String
  dataSource             DataSource             @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  collectionRunId        String
  collectionRun          CollectionRun          @relation(fields: [collectionRunId, dataSourceId], references: [id, dataSourceId], onDelete: Restrict)
  externalMessageId      String
  revision               Int
  sourceDate             DateTime
  editDate               DateTime?
  collectedAt            DateTime               @default(now())
  authorId               String?
  authorUsernameSnapshot String?
  authorDisplaySnapshot  String?
  senderChatId           String?
  replyToMessageId       String?
  forwardedFrom          String?
  rawText                String?
  normalizedText         String?
  entitiesJson           String?
  payloadHash            String
  payloadRawJson         String?
  editState              String                 @default("original")
  deletionEvidence       String?
  collectorVersion       String

  media                  MessageMedia[]
  classifications        ResultClassification[]
  validations            ValidationRecord[]

  @@unique([dataSourceId, externalMessageId, revision])
  @@index([dataSourceId, sourceDate])
  @@index([collectionRunId])
  @@index([payloadHash])
}

// Metadata only; media bytes are stored outside this schema, if ever authorized.
model MessageMedia {
  id               String        @id @default(uuid())
  sourceMessageId  String
  sourceMessage    SourceMessage @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)
  mediaType        String
  fileUniqueId     String?
  mimeType         String?
  fileSizeBytes    Int?
  position         Int           @default(0)
  createdAt        DateTime      @default(now())

  @@unique([sourceMessageId, position])
  @@index([fileUniqueId])
}

// One message can describe several independent betting records.
model ResultClassification {
  id              String        @id @default(uuid())
  sourceMessageId String
  sourceMessage   SourceMessage @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)
  recordKey       String
  tipId           String?
  tip             Tip?          @relation(fields: [tipId], references: [id], onDelete: SetNull)
  category        String
  origin          String
  confidence      String
  evidence        String?
  justification   String?
  ruleCode        String?
  flagsJson       String?
  reviewRequired  Boolean       @default(false)
  classifierVersion String
  classifiedAt    DateTime      @default(now())

  validations     ValidationRecord[]

  @@index([sourceMessageId, recordKey, classifiedAt])
  @@index([tipId])
  @@index([category, classifiedAt])
}

// Findings are evidence records; correction of source data is a separate action.
model ValidationRecord {
  id                    String                @id @default(uuid())
  sourceMessageId       String?
  sourceMessage         SourceMessage?        @relation(fields: [sourceMessageId], references: [id], onDelete: Restrict)
  resultClassificationId String?
  resultClassification  ResultClassification? @relation(fields: [resultClassificationId], references: [id], onDelete: Restrict)
  ruleCode              String
  severity              String
  evidence              String
  description           String
  status                String                @default("open")
  validatorVersion      String
  createdAt             DateTime              @default(now())
  reviewedAt            DateTime?

  @@index([sourceMessageId])
  @@index([resultClassificationId])
  @@index([status, severity])
}

model CollectionRun {
  id               String          @id @default(uuid())
  dataSourceId     String
  dataSource       DataSource      @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  startedAt        DateTime
  finishedAt       DateTime?
  status           String
  receivedCount    Int             @default(0)
  newMessageCount  Int             @default(0)
  skippedCount     Int             @default(0)
  errorCount       Int             @default(0)
  errorCode        String?
  errorDetail      String?
  collectorVersion String
  createdAt        DateTime        @default(now())

  messages         SourceMessage[]

  @@unique([id, dataSourceId])
  @@index([dataSourceId, startedAt])
  @@index([status, startedAt])
}
