# Normalização de fim de linha: LF no repositório
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binários (nunca normalizar)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.db binary
*.sqlite binary
*.sqlite3 binary
