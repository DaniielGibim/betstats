# Exemplo sanitizado. Copie para .env e ajuste localmente.
# Nunca versione o .env real nem credenciais.
DATABASE_URL="file:./dev.db"
NODE_ENV="development"
# Obrigatório para assinar sessões; use um valor aleatório exclusivo de ao menos 32 bytes.
SESSION_SECRET=""
# Cadastro público fica fechado em produção; habilite somente com política de entrada definida.
ALLOW_PUBLIC_REGISTRATION="false"
